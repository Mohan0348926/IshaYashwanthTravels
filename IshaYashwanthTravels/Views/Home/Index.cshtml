    <!-- ================= BOOKING MODAL ================= -->
    <div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content booking-modal-content">

                <div class="modal-header border-0">
                    <h5 class="modal-title">
                        <i class="fa-solid fa-route me-2 text-warning"></i>
                        Book Your Trip
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body pt-0">

                    <div id="bookingResponse"></div>

                    <form id="bookingForm">

                        @Html.AntiForgeryToken()

                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="bookingName" name="Name" placeholder="Your Name" required />
                            <label for="bookingName">Your Name</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="bookingEmail" name="Email" placeholder="Email Address" required />
                            <label for="bookingEmail">Email Address</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="tel" class="form-control" id="bookingPhone" name="Phone" placeholder="Phone Number" required />
                            <label for="bookingPhone">Phone Number</label>
                        </div>

                        <div class="form-floating mb-3">
                            <select class="form-select" id="bookingVehicle" name="VehicleType">
                                <option value="Innova">Innova</option>
                                <option value="Innova Crysta">Innova Crysta</option>
                                <option value="Etios">Etios</option>
                                <option value="Ertiga">Ertiga</option>
                                <option value="Bus 21 Seater">Bus 21 Seater</option>
                                <option value="Bus 25 Seater">Bus 25 Seater</option>
                                <option value="Bus 35 Seater">Bus 35 Seater</option>
                                <option value="Bus 40 Seater">Bus 40 Seater</option>
                                <option value="Bus 50 Seater">Bus 50 Seater</option>
                                <option value="Not Sure">Not Sure Yet</option>
                            </select>
                            <label for="bookingVehicle">Preferred Vehicle</label>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea class="form-control" id="bookingMessage" name="Message" placeholder="Where do you want to travel?" style="height: 100px" required></textarea>
                            <label for="bookingMessage">Where do you want to travel?</label>
                        </div>

                        <button type="submit" class="btn btn-warning btn-lg rounded-pill px-5 w-100">
                            <i class="fa-solid fa-paper-plane me-2"></i>
                            Submit Booking
                        </button>

                    </form>

                </div>

